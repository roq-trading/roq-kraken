{
  "name": "WS",
  "type": "flags",
  "prefix": "ws_",
  "values": [
    {
      "name": "public_uri",
      "type": "roq::io::web::URI",
      "validator": "roq::core::flags::URI",
      "default": "wss://beta-ws.kraken.com",
      "description": "WebSocket end-point (URI)"
    },
    {
      "name": "public_ping_freq",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "5s",
      "description": "ping frequency"
    },
    {
      "name": "public_request_timeout",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "15s",
      "description": "request timeout"
    },
    {
      "name": "public_subscribe_book_depth",
      "type": "uint16_t",
      "validator": "roq::flags::validators::Positive<uint16_t>",
      "default": 10,
      "description": "book depth (size)"
    },
    {
      "name": "public_max_subscriptions_per_stream",
      "type": "uint32_t",
      "validator": "roq::flags::validators::Positive<uint32_t>",
      "default": 128,
      "description": "max subscriptions per connection (count)"
    },
    {
      "name": "private_uri",
      "type": "roq::io::web::URI",
      "validator": "roq::core::flags::URI",
      "default": "wss://beta-ws-auth.kraken.com",
      "description": "WebSocket end-point (URI)"
    },
    {
      "name": "private_ping_freq",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "5s",
      "description": "ping frequency"
    },
    {
      "name": "private_request_timeout",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "15s",
      "description": "request timeout"
    }
  ]
}
